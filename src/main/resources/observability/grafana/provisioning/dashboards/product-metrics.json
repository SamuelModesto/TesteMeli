{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "target": { "limit": 100, "matchAny": false, "tags": [], "type": "dashboard" },
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Taxa de Busca de Produtos (por Status)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(product_search_total{application=~\"$application\",env=~\"$env\",region=~\"$region\"}[5m])) by (status)",
          "legendFormat": "{{status}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0 } }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latência da Busca (p50 / p95 / p99)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "max(product_search_duration_seconds{quantile=\"0.5\",application=~\"$application\",env=~\"$env\",region=~\"$region\"})",
          "legendFormat": "p50",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        },
        {
          "refId": "B",
          "expr": "max(product_search_duration_seconds{quantile=\"0.95\",application=~\"$application\",env=~\"$env\",region=~\"$region\"})",
          "legendFormat": "p95",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        },
        {
          "refId": "C",
          "expr": "max(product_search_duration_seconds{quantile=\"0.99\",application=~\"$application\",env=~\"$env\",region=~\"$region\"})",
          "legendFormat": "p99",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p50" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#1F78C1" } }]
          },
          {
            "matcher": { "id": "byName", "options": "p95" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#EAB839" } }]
          },
          {
            "matcher": { "id": "byName", "options": "p99" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#E24D42" } }]
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Throughput HTTP (req/s)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{application=~\"$application\",env=~\"$env\",region=~\"$region\",uri!~\"/actuator/.*\"}[5m]))",
          "legendFormat": "req/s",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0 } }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Erros HTTP 5xx (req/s)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{application=~\"$application\",env=~\"$env\",region=~\"$region\",status=~\"5..\",uri!~\"/actuator/.*\"}[5m]))",
          "legendFormat": "5xx req/s",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0 } }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Saturação do Pool Hikari (active/max)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "expr": "max(hikaricp_connections_active{application=~\"$application\",env=~\"$env\",region=~\"$region\"} / hikaricp_connections_max{application=~\"$application\",env=~\"$env\",region=~\"$region\"})",
          "legendFormat": "pool saturation",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0 }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Heap Usage (used/max)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\",application=~\"$application\",env=~\"$env\",region=~\"$region\"}) / sum(jvm_memory_max_bytes{area=\"heap\",application=~\"$application\",env=~\"$env\",region=~\"$region\"})",
          "legendFormat": "heap used/max",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0 }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "GC Pause (max) (seg)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        {
          "refId": "A",
          "expr": "max(jvm_gc_pause_seconds_max{application=~\"$application\",env=~\"$env\",region=~\"$region\"})",
          "legendFormat": "gc pause max",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0 } }, "overrides": [] }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Ratio NOT_FOUND (últimos 5m)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(product_search_total{status=\"not_found\",application=~\"$application\",env=~\"$env\",region=~\"$region\"}[5m])) / clamp_min(sum(rate(product_search_total{application=~\"$application\",env=~\"$env\",region=~\"$region\"}[5m])), 1e-9)",
          "legendFormat": "not_found ratio",
          "range": true,
          "instant": true,
          "editorMode": "code",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "orange", "value": 0.05 }, { "color": "red", "value": 0.15 }] } },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Saturação Pool Hikari (agora)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "max(hikaricp_connections_active{application=~\"$application\",env=~\"$env\",region=~\"$region\"} / hikaricp_connections_max{application=~\"$application\",env=~\"$env\",region=~\"$region\"})",
          "range": true,
          "instant": true,
          "editorMode": "code",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "orange", "value": 0.7 }, { "color": "red", "value": 0.9 }] } },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "HTTP 5xx (req/s agora)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{application=~\"$application\",env=~\"$env\",region=~\"$region\",status=~\"5..\",uri!~\"/actuator/.*\"}[5m]))",
          "range": true,
          "instant": true,
          "editorMode": "code",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "orange", "value": 0.1 }, { "color": "red", "value": 1 }] } },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Heap Usage (agora)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\",application=~\"$application\",env=~\"$env\",region=~\"$region\"}) / sum(jvm_memory_max_bytes{area=\"heap\",application=~\"$application\",env=~\"$env\",region=~\"$region\"})",
          "range": true,
          "instant": true,
          "editorMode": "code",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "orange", "value": 0.7 }, { "color": "red", "value": 0.85 }] } },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Caffeine Cache - Hits vs Misses (req/s)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cache_gets_total{cache=\"products\", result=\"hit\"}[5m]))",
          "legendFormat": "Hits",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        },
        {
          "refId": "B",
          "expr": "sum(rate(cache_gets_total{cache=\"products\", result=\"miss\"}[5m]))",
          "legendFormat": "Misses",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0 } }, "overrides": [] }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Caffeine Cache - Taxa de Evicção (evictions/s)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cache_evictions_total{cache=\"products\"}[5m]))",
          "legendFormat": "Evictions",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0 } }, "overrides": [] }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["ml", "micrometer", "prometheus"],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "DS_PROMETHEUS",
        "label": "Datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "prometheus" }
      },
      {
        "type": "query",
        "name": "application",
        "label": "application",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(jvm_info, application)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": ".*" }
      },
      {
        "type": "query",
        "name": "env",
        "label": "env",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(jvm_info{application=~\"$application\"}, env)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": ".*" }
      },
      {
        "type": "query",
        "name": "region",
        "label": "region",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(jvm_info{application=~\"$application\",env=~\"$env\"}, region)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": ".*" }
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "ML Product API Metrics (Entrevista)",
  "uid": "product-metrics-api",
  "version": 1,
  "weekStart": ""
}
